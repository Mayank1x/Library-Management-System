@{
    ViewData["Title"] = "Home Page";
}

<div class="row my-5">
    <div class="col-12 text-center mb-4">
        <h1 class="display-4 text-white" style="font-weight: 700; text-shadow: 0 0 15px var(--neon-accent);">Welcome to the Future of Libraries</h1>
        <p class="lead text-light">Explore our featured collection of premium books.</p>
    </div>
    
    <div class="col-md-4 mb-4">
        <div class="card h-100 glass-card">
            <div class="card-body d-flex flex-column">
                <h3 class="card-title text-white" style="text-shadow: 0 0 10px var(--neon-accent);">The Pragmatic Programmer</h3>
                <h6 class="card-subtitle mb-2 text-info">Andrew Hunt and David Thomas</h6>
                <p class="card-text text-light flex-grow-1">
                    Journey into mastery with the classic guide that has helped generations of programmers become better software developers.
                </p>
                <a href="/Books/Details/1" class="btn btn-primary btn-neon mt-auto">View Details</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 mb-4">
        <div class="card h-100 glass-card">
            <div class="card-body d-flex flex-column">
                <h3 class="card-title text-white" style="text-shadow: 0 0 10px var(--neon-accent);">Clean Architecture</h3>
                <h6 class="card-subtitle mb-2 text-info">Robert C. Martin</h6>
                <p class="card-text text-light flex-grow-1">
                    Learn the universal rules of software architecture that will help you dramatically improve programmer productivity throughout the life of any software system.
                </p>
                <a href="/Books/Details/5" class="btn btn-primary btn-neon mt-auto">View Details</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 mb-4">
        <div class="card h-100 glass-card">
            <div class="card-body d-flex flex-column">
                <h3 class="card-title text-white" style="text-shadow: 0 0 10px var(--neon-accent);">Domain-Driven Design</h3>
                <h6 class="card-subtitle mb-2 text-info">Eric Evans</h6>
                <p class="card-text text-light flex-grow-1">
                    Tackling complexity in the heart of software by embedding domain logic directly into the models of your application.
                </p>
                <a href="/Books/Details/8" class="btn btn-primary btn-neon mt-auto">View Details</a>
            </div>
        </div>
    </div>
</div>
