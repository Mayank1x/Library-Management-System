<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LibraryManagement</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" href="/">LMS<span class="text-white">CORE</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="AboutUs" asp-action="Index">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="ContactUs" asp-action="Index">Contact Us</a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link" href="/Books/Index">Books</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Publications/Index?type=Newspaper">Newspapers</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Publications/Index?type=Magazine">Magazines</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Student/Index">Students</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Librarian/Index">Librarians</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Login/Logout">Logout</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" href="/Login/Index">Login</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main>
        <div class="container mt-4">
            @RenderBody()
        </div>
    </main>
    <footer class="footer mt-auto py-4 text-light">
        <div class="container text-center">
            <span class="text-muted-glass" style="font-size: 0.9rem;">&copy; @DateTime.Now.Year - LMS Core Platform. Crafted with precision.</span>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            // Dynamically wrap tables in glass containers for the sleek look
            $('table.table').wrap('<div class="glass-table-container"></div>');
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
