@model LMSystem.Models.Publication
@{
    ViewData["Title"] = "Edit " + ViewData["CurrentType"];
}
<h2 class="text-white">@ViewData["Title"]</h2>
<hr class="text-light" />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" class="glass-card p-4">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Type" />
            <input type="hidden" asp-for="IsAvailable" />
            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label text-white"></label>
                <input asp-for="Title" class="form-control text-white" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2);" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Publisher" class="control-label text-white"></label>
                <input asp-for="Publisher" class="form-control text-white" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2);" />
                <span asp-validation-for="Publisher" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="PublishedDate" class="control-label text-white"></label>
                <input asp-for="PublishedDate" class="form-control text-white" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2);" type="date" />
                <span asp-validation-for="PublishedDate" class="text-danger"></span>
            </div>
            <div class="form-group mt-4">
                <input type="submit" value="Save" class="btn btn-primary btn-neon w-100" />
            </div>
        </form>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Index" asp-route-type="@ViewData["CurrentType"]" class="btn btn-outline-light">Back to List</a>
</div>
