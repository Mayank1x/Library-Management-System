@model LMSystem.Models.Publication
@{
    ViewData["Title"] = "Delete";
}
<h2 class="text-white">Delete @Model.Type</h2>
<h4 class="text-danger">Are you sure you want to delete this?</h4>
<hr class="text-light" />
<div class="glass-card p-4">
    <dl class="row text-white">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>
        
        <dt class="col-sm-2">Publisher</dt>
        <dd class="col-sm-10">@Model.Publisher</dd>
        
        <dt class="col-sm-2">Published Date</dt>
        <dd class="col-sm-10">@Model.PublishedDate.ToString("yyyy-MM-dd")</dd>
        
        <dt class="col-sm-2">Available</dt>
        <dd class="col-sm-10">@(Model.IsAvailable ? "Yes" : "No")</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger btn-neon" /> |
        <a asp-action="Index" asp-route-type="@Model.Type" class="btn btn-outline-light">Back to List</a>
    </form>
</div>
