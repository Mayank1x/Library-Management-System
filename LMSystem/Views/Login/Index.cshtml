@model LoginModel
@{
    ViewData["Title"] = "Secure Login";
}

<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-5">
        <div class="glass-card p-5 text-center">
            <h2 class="text-neon mb-2 fw-bold">LMS Gateway</h2>
            <p class="text-muted-glass mb-5">Enter your credentials to access the system.</p>
            
            <form asp-action="Verify" method="post">
                <div class="mb-4 text-start">
                    <label class="control-label">Username</label>
                    <input asp-for="username" class="form-control form-control-lg" required placeholder="admin" />
                </div>
                <div class="mb-5 text-start">
                    <label class="control-label">Password</label>
                    <input asp-for="password" type="password" class="form-control form-control-lg" required placeholder="••••••••" />
                </div>
                <button type="submit" class="btn btn-neon w-100 btn-lg text-uppercase" style="letter-spacing: 1px;">Access Secure System</button>
                
                @if (ViewBag.message != null)
                {
                    <div class="alert alert-danger mt-4 bg-transparent border-danger text-danger" style="border-radius: 8px;">
                        @ViewBag.message
                    </div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success mt-4 bg-transparent border-success text-success" style="border-radius: 8px;">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <div class="mt-4 text-center">
                    <p class="text-muted-glass mb-0">Don't have an account? <a asp-action="Register" class="text-neon text-decoration-none">Sign Up</a></p>
                </div>
            </form>
        </div>
    </div>
</div>
