@{
    ViewData["Title"] = "Contact Us";
}

<div class="container mt-5">
    <div class="row mb-5 text-center">
        <div class="col-12">
            <h1 class="display-4 text-white" style="font-weight: 700; text-shadow: 0 0 15px var(--neon-accent);">Contact Us</h1>
            <p class="lead text-light">We're here to help! Reach out to us below.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-7 mb-4">
            <div class="glass-card p-4 text-white h-100">
                <h3 class="mb-4" style="color: var(--neon-accent);">Send a Message</h3>
                <form action="#" method="post">
                    <div class="mb-3">
                        <label for="fullName" class="form-label">Full Name</label>
                        <input type="text" class="form-control text-white" id="fullName" name="fullName" required style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);">
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">Email Address</label>
                        <input type="email" class="form-control text-white" id="email" name="email" required style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);">
                    </div>
                    <div class="mb-3">
                        <label for="message" class="form-label">Your Message</label>
                        <textarea class="form-control text-white" id="message" name="message" rows="5" required style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-neon w-100 mt-2">Submit Ticket</button>
                </form>
            </div>
        </div>
        
        <div class="col-md-5 mb-4">
            <div class="glass-card p-4 text-white h-100">
                <h3 class="mb-4" style="color: var(--neon-accent);">Support Desk</h3>
                <p>
                    If you have any questions or need assistance with the Library Management System, 
                    our dedicated support team is ready to help you during our business hours.
                </p>
                
                <h5 class="mt-4" style="color: #0dcaf0;">Email</h5>
                <p>support@librarymanagement.com</p>

                <h5 class="mt-4" style="color: #0dcaf0;">Business Hours</h5>
                <p>Monday – Friday: 9:00 AM – 6:00 PM</p>
            </div>
        </div>
    </div>
</div>
