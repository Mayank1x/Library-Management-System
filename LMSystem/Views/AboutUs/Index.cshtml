@{
    ViewData["Title"] = "About Us";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-12 text-center mb-5">
            <h1 class="display-4 text-white" style="font-weight: 700; text-shadow: 0 0 15px var(--neon-accent);">About Library Management System</h1>
        </div>
    </div>

    <div class="glass-card p-5 mb-5 text-white">
        <h2 style="color: var(--neon-accent);">Welcome!</h2>
        <p class="lead">
            Welcome to the future of library administration. We are dedicated to providing an elegant, efficient, and 
            powerful platform for managing books, tracking student borrowings, and organizing library staff seamlessly.
        </p>

        <h3 class="mt-4" style="color: var(--neon-accent);">Our Mission</h3>
        <p>
            Our mission is to simplify knowledge sharing. By bridging the gap between cutting-edge technology and 
            classic literature, we aim to make libraries more accessible, manageable, and beautifully organized.
        </p>
    </div>

    <div class="row text-white text-center">
        <div class="col-md-4 mb-4">
            <div class="glass-card p-4 h-100">
                <h4 style="color: var(--neon-accent);">Our Vision</h4>
                <p>To digitize every library and make tracking resources completely effortless.</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="glass-card p-4 h-100">
                <h4 style="color: var(--neon-accent);">Smart Tracking</h4>
                <p>Never lose a book again. Real-time updates on active borrowings and availability.</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="glass-card p-4 h-100">
                <h4 style="color: var(--neon-accent);">Easy Access</h4>
                <p>An intuitive interface that works beautifully for both students and administrators.</p>
            </div>
        </div>
    </div>
</div>
